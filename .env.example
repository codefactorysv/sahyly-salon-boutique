# ==========================================================
# Sahyly Salon & Boutique — ejemplo de variables de entorno
# Copiar a .env y rellenar los valores. .env NUNCA se sube a git.
# ==========================================================

# API key de Resend (https://resend.com/api-keys).
# Solo se lee en el servidor (server/mailer.js). Nunca se expone al navegador.
RESEND_API_KEY=

# Correo del salón que recibe las solicitudes de cita.
CONTACT_TO_EMAIL=

# Remitente. Formato: "Nombre <correo@dominio.com>".
#
# IMPORTANTE — modo de pruebas de Resend:
# Mientras no haya un dominio verificado en Resend, el remitente debe ser
# onboarding@resend.dev y Resend SOLO entrega al correo con el que se creó
# la cuenta. Cualquier otro destinatario devuelve error 403 ("You can only
# send testing emails to your own email address").
#
# Para enviar a Sahylysalon@gmail.com hay que verificar el dominio del salón:
#   1. resend.com/domains -> Add Domain (ej. sahylysalon.com)
#   2. Copiar los registros DNS (MX, SPF/TXT y DKIM) al proveedor del dominio.
#   3. Esperar a que Resend marque el dominio como "Verified".
#   4. Cambiar aquí CONTACT_FROM_EMAIL a "Sahyly Salon <citas@sahylysalon.com>"
#      y reiniciar el servidor. No hay que tocar código.
CONTACT_FROM_EMAIL=

# Opcional: URL pública del sitio. Si se define, el correo muestra el logo
# real (PUBLIC_SITE_URL/img/logo.png). Si no, usa el nombre estilizado.
PUBLIC_SITE_URL=

# Puerto del servidor Express (por defecto 3000).
PORT=
